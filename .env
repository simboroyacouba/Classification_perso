# =============================================================================
# Configuration EfficientNet-B3 Perso — Toitures cadastrales
# =============================================================================

# --- Dataset (même que les autres modèles) ---
DETECTION_DATASET_IMAGES_DIR=../dataset1/images/default
DETECTION_DATASET_ANNOTATIONS_FILE=../dataset1/annotations/instances_default.json

# --- Classes ---
CLASSES_FILE=classes.yaml

# --- Modèle à évaluer / inférer (à remplir après train.py) ---
# Exemple : runs/classify/train/perso_20260430_143000/best_model.pth
MODEL_PATH=

# --- Dossier de sortie évaluation ---
EVALUATION_DIR=./evaluation

# --- Hyperparamètres entraînement ---
NUM_EPOCHS=60
BATCH_SIZE=16
LEARNING_RATE=1e-3
LR_BACKBONE=1e-5
WEIGHT_DECAY=1e-4
FREEZE_EPOCHS=10
PRETRAINED=true
MIN_CROP_SIZE=10

# --- Split dataset ---
TRAIN_SPLIT=0.70
VAL_SPLIT=0.20
TEST_SPLIT=0.10

# --- Sauvegarde ---
SAVE_EVERY=5

# --- Background mining (réduit les faux positifs en inférence sliding window) ---
# Nombre de crops "fond" générés par image d'entraînement (0 = désactivé)
BG_CROPS_PER_IMG=3
# IoU max d'un crop background avec les annotations (doit être < threshold pour être retenu)
BG_IOU_THRESHOLD=0.1
